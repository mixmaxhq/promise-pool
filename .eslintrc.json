{
    "extends": [
        "mixmax/node",
        "mixmax/prettier"
    ],
    "overrides": [
        {
            "files": ["*.ts"],
            "parser": "@typescript-eslint/parser",
            "parserOptions": {
                "sourceType": "module"
            },
            "plugins": ["@typescript-eslint"],
            "rules": {
                "no-unused-vars": "off",
                "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }]
            }
        }
    ],
    "ignorePatterns": ["vitest.config.ts"]
}
